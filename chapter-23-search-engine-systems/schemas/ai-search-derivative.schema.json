{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISearchDerivative",
  "type": "object",
  "required": [
    "derivativeId",
    "derivativeType",
    "sourceId",
    "sourceVersion",
    "policyVersion",
    "derivativeStatus",
    "createdAt"
  ],
  "properties": {
    "derivativeId": {
      "type": "string"
    },
    "derivativeType": {
      "type": "string",
      "enum": [
        "EXTRACTED_TEXT",
        "CHUNK",
        "EMBEDDING",
        "SUMMARY",
        "QUERY_REWRITE",
        "RERANKED_PASSAGE",
        "GENERATED_ANSWER"
      ]
    },
    "sourceId": {
      "type": "string"
    },
    "sourceVersion": {
      "type": "string"
    },
    "sourceContentHash": {
      "type": "string"
    },
    "parserVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "chunkingPolicyVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "embeddingModelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "rerankerVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "promptVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "policyVersion": {
      "type": "string"
    },
    "derivativeStatus": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "invalidated",
        "rebuilding",
        "failed"
      ]
    },
    "invalidationReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "rebuildReceiptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "invalidatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
