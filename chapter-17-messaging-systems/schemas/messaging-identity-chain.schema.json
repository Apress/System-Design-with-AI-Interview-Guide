  "title": "MessagingIdentityChain",
  "type": "object",
  "required": [
    "eventId",
    "businessTxnId",
    "effectId",
    "capability"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "businessTxnId": {
      "type": "string"
    },
    "effectId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "chainId": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "entityKey": {
      "type": "string"
    },
    "sequenceNumber": {
      "type": "integer"
    }
  }
}
