{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCommit",
  "type": "object",
  "required": [
    "orderCommitId",
    "checkoutIntentId",
    "orderId",
    "customerId",
    "committedAt",
    "commitStatus",
    "tokens",
    "policyVersion"
  ],
  "properties": {
    "orderCommitId": {
      "type": "string"
    },
    "checkoutIntentId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "committedAt": {
      "type": "string",
      "format": "date-time"
    },
    "commitStatus": {
      "type": "string",
      "enum": [
        "confirmed",
        "pending",
        "backorder",
        "requires_review",
        "refused"
      ]
    },
    "tokens": {
      "type": "object",
      "properties": {
        "inventoryHoldId": {
          "type": "string"
        },
        "reservationId": {
          "type": "string"
        },
        "paymentAuthId": {
          "type": "string"
        },
        "fraudDecisionId": {
          "type": "string"
        },
        "fulfillmentEligibilityId": {
          "type": "string"
        }
      }
    },
    "policyVersion": {
      "type": "string"
    },
    "customerVisibleState": {
      "type": "string"
    }
  }
}
