    Browse --> CartIntent
    CartIntent --> CheckoutIntent
    CheckoutIntent --> InventoryHold
    InventoryHold --> PaymentAuthorized
    PaymentAuthorized --> Reserved
    Reserved --> Confirmed: orderCommitId
